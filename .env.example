# Copy to .env and adjust. All values shown are the defaults.

# PostgreSQL server
PGHOST=localhost
PGPORT=5432

# Superuser used ONLY by `npm run db:setup` / `db:reset` (creates roles, DB, extensions)
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=postgres
PG_ADMIN_DATABASE=postgres

# Database name and the password of the restricted role the API connects as (hms_app)
DB_NAME=hospital
APP_DB_PASSWORD=hms_app_password

# Optional: time zone used for "today" in the demo history (defaults to this machine's zone)
# DB_TIMEZONE=Asia/Kolkata

# API port (the React dev server proxies /api here)
API_PORT=4000
